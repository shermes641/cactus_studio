{
  "compilerOptions": {
    "target": "es6",
    "module": "es2020",
    "strict": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["DOM", "ES2021"],
    "noEmitOnError": false,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "netlify",
    "netlify/functions"
  ]
}
